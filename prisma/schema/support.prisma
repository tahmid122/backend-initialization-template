enum SupportStatus {
    PENDING
    IN_PROGRESS
    RESOLVED
}

model Support {
    id         String        @id @default(uuid())
    problem    String
    adminReply String?
    userId     String
    user       User          @relation(fields: [userId], references: [id])
    status     SupportStatus @default(PENDING)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
