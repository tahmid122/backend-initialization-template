enum OtpPurpose {
    REGISTER
    FORGOT_PASSWORD
}

model OTP {
    id        String     @id @default(uuid())
    email     String
    otp       String
    purpose   OtpPurpose
    expiresAt DateTime
    isUsed    Boolean    @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([email])
}
